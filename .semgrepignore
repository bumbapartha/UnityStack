# Paths Semgrep does not scan (TD-02). This file replaces Semgrep's defaults, so keep the standard
# entries. Every entry needs a one-line reason on the line above it. Do not ignore findings here;
# fix them, or use a `nosemgrep: <rule-id>` comment with a reason next to the code.

# Git-ignored files (build output, dependencies, .env) are not source code.
:include .gitignore
# Generated drawings (Excalidraw JSON); they contain no code.
*.excalidraw
# Generated lockfiles; dependency vulnerabilities are Trivy's job.
frontend/yarn.lock
backend/gradle.lockfile
# Gradle wrapper scripts and jar are generated by Gradle, not written by us.
backend/gradlew
backend/gradlew.bat
backend/gradle/wrapper/
