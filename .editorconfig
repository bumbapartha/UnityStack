# Shared editor settings. Prettier (frontend, Markdown) and Spotless (Java) apply the full style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,kts,sql}]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
