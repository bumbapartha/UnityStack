# Copy to .env and adjust. Never commit .env.
# mock = scripted questions, no API key needed. openai = real model.
UNITYSTACK_AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Host port for PostgreSQL (container still listens on 5432)
UNITYSTACK_DB_PORT=5433

# Optional tool profiles to start with every `docker compose up` (see docs/dev-setup.md)
# COMPOSE_PROFILES=pm,monitoring
